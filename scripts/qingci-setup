#!/bin/sh
# 清辞拼音 —— 一键配置脚本（随 deb 安装到 /usr/bin）
# 作用：把系统输入法框架切换为 fcitx5，并写入 Wayland/X11 会话所需的
#       输入法环境变量（幂等，可重复执行）。
# 用法：sudo qingci-setup
set -e

# 确定真实用户的 home（sudo 运行时 SUDO_USER 才是登录用户，
# im-config/xinputrc 必须落在用户目录而非 /root）
if [ "$(id -u)" = "0" ] && [ -n "${SUDO_USER:-}" ]; then
    USER_HOME="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    RUN_AS="$SUDO_USER"
else
    USER_HOME="${HOME:-/root}"
    RUN_AS=""
fi

# 1) 用户级 xinputrc（im-config 的用户配置文件）。
#    不调用 im-config 工具本身：其 -n 模式在无显示环境（SSH 等）下会
#    静默失败（RC=1），直接写它 source 的配置文件更可靠。
printf '# 由 qingci-setup 生成：默认输入法框架 fcitx5\nrun_im fcitx5\n' \
    > "$USER_HOME/.xinputrc"
if [ -n "$RUN_AS" ]; then
    chown "$RUN_AS:$RUN_AS" "$USER_HOME/.xinputrc"
fi

# 2) 写入会话环境变量（幂等：已存在则改写，缺省则追加）
#    GNOME Wayland 会话依赖这些变量把应用输入路由到 fcitx5。
ENV_FILE=/etc/environment
touch "$ENV_FILE"
for kv in \
    "GTK_IM_MODULE=fcitx" \
    "QT_IM_MODULE=fcitx" \
    "XMODIFIERS=@im=fcitx" \
    "SDL_IM_MODULE=fcitx"; do
    key="${kv%%=*}"
    if grep -q "^${key}=" "$ENV_FILE"; then
        sed -i "s|^${key}=.*|${kv}|" "$ENV_FILE"
    else
        echo "$kv" >> "$ENV_FILE"
    fi
done

# 3) 写入无条件自启条目（系统级）
#    Ubuntu 的 fcitx5 包不自带 autostart 条目，GNOME 下 fcitx5 不会随
#    会话启动；此条目无 NotShowIn/OnlyShowIn 限制，保证所有桌面环境自启。
if [ ! -f /etc/xdg/autostart/qingci-fcitx5-autostart.desktop ]; then
    mkdir -p /etc/xdg/autostart
    cat > /etc/xdg/autostart/qingci-fcitx5-autostart.desktop <<'DESKTOP'
[Desktop Entry]
Name=Qingci Fcitx5 Autostart
Comment=启动 fcitx5 输入法框架（清辞拼音）
Exec=fcitx5
TryExec=fcitx5
Terminal=false
Type=Application
X-GNOME-Autostart-enabled=true
DESKTOP
fi

# 4) 应用深色圆角候选窗口主题（仅当用户尚未自定义经典界面配置时）
CUI_CONF="$USER_HOME/.config/fcitx5/conf/classicui.conf"
if [ ! -f "$CUI_CONF" ]; then
    mkdir -p "$(dirname "$CUI_CONF")"
    # 注意：fcitx5 的 addon 配置为平铺键值（无 [ClassicUI] 段头），
    # 加段头会导致键被忽略、主题静默回退 default。为兼容旧版同时写一份段头形式。
    cat > "$CUI_CONF" <<'CONF'
Theme=qingci-dark
Vertical Candidate List=False

[ClassicUI]
Theme=qingci-dark
Vertical Candidate List=False
CONF
    if [ -n "$RUN_AS" ]; then
        chown -R "$RUN_AS:$RUN_AS" "$USER_HOME/.config/fcitx5"
    fi
fi

cat <<'EOF'

配置完成。请执行以下两步：

  1. 注销并重新登录（环境变量与会话级自动启动生效）
  2. 运行 fcitx5-configtool，在「输入法」页取消「仅显示当前语言」，
     搜索「清辞拼音」并添加到列表

之后用 Ctrl+Space 切换到清辞拼音即可输入。
EOF
