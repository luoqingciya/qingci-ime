#!/bin/sh
# 清辞拼音 —— 一键配置脚本（随 deb 安装到 /usr/bin）
# 作用：把系统输入法框架切换为 fcitx5，并写入 Wayland/X11 会话所需的
#       输入法环境变量（幂等，可重复执行）。
# 用法：sudo qingci-setup
set -e

# 1) 切换 im-config 默认框架为 fcitx5
if command -v im-config >/dev/null 2>&1; then
    im-config -n fcitx5
else
    echo "提示：未安装 im-config（sudo apt install im-config 后重跑本脚本）"
fi

# 2) 写入会话环境变量（幂等：已存在则改写，缺省则追加）
#    GNOME Wayland 会话依赖这些变量把应用输入路由到 fcitx5。
ENV_FILE=/etc/environment
touch "$ENV_FILE"
for kv in \
    "GTK_IM_MODULE=fcitx" \
    "QT_IM_MODULE=fcitx" \
    "XMODIFIERS=@im=fcitx" \
    "SDL_IM_MODULE=fcitx"; do
    key="${kv%%=*}"
    if grep -q "^${key}=" "$ENV_FILE"; then
        sed -i "s|^${key}=.*|${kv}|" "$ENV_FILE"
    else
        echo "$kv" >> "$ENV_FILE"
    fi
done

# 3) 确认 fcitx5 开机自启项存在（fcitx5 主包自带，缺则从包内补）
# 3) 写入无条件自启条目（系统级）
#    fcitx5 包自带的 /etc/xdg/autostart/org.fcitx.Fcitx5.desktop 在 GNOME
#    会话下会被条件过滤跳过，导致每次开机 fcitx5 不运行；此条目无任何
#    NotShowIn/OnlyShowIn 限制，保证所有桌面环境自启。
if [ ! -f /etc/xdg/autostart/qingci-fcitx5-autostart.desktop ]; then
    mkdir -p /etc/xdg/autostart
    cat > /etc/xdg/autostart/qingci-fcitx5-autostart.desktop <<'DESKTOP'
[Desktop Entry]
Name=Qingci Fcitx5 Autostart
Comment=启动 fcitx5 输入法框架（清辞拼音）
Exec=fcitx5
TryExec=fcitx5
Terminal=false
Type=Application
X-GNOME-Autostart-enabled=true
DESKTOP
fi

cat <<'EOF'

配置完成。请执行以下两步：

  1. 注销并重新登录（环境变量与会话级自动启动生效）
  2. 运行 fcitx5-configtool，在「输入法」页取消「仅显示当前语言」，
     搜索「清辞拼音」并添加到列表

之后用 Ctrl+Space 切换到清辞拼音即可输入。
EOF
